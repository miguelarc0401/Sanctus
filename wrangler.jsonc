// Publicación en Cloudflare Workers: sólo archivos estáticos de dist/.
// "single-page-application" hace que rutas como /entrar carguen la app en lugar de dar 404.
{
  "name": "sanctus",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
